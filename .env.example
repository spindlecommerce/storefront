# The platform API. It serves GraphQL at /graphql and the visual editing bridge.
SPINDLE_API_URL=http://localhost:4000

# The channel to sell in. The demo data has "eu" (the default) and "us".
SPINDLE_CHANNEL=eu

# Optional: the languages and currencies to offer, comma separated. The first of each is the
# default, and the default language has no URL prefix. For "us", use en-US and USD.
# SPINDLE_LOCALES=en-GB,de-DE,fr-FR
# SPINDLE_CURRENCIES=GBP,EUR

# Signing secret for /api/revalidate. The admin shows it once, when you set this storefront's
# revalidate path under Settings › Storefronts. Empty turns the endpoint off.
SPINDLE_REVALIDATE_SECRET=

# Optional: origins allowed to frame the storefront for visual editing, comma separated.
# Defaults to the API's origin, which serves the admin.
# SPINDLE_ADMIN_ORIGIN=http://localhost:4000

# Optional: this storefront's public URL, for the sitemap and canonical links. On Vercel it
# defaults to the project's production domain.
# SPINDLE_SITE_URL=http://localhost:3000

# Optional: hosts the platform's media storage serves images from, other than Vercel Blob and the
# API (an S3, R2 or Supabase Storage URL, or a CDN), so next/image optimizes them. Comma separated.
# SPINDLE_MEDIA_HOSTS=https://cdn.example.com,https://pub-1234.r2.dev

# Optional: an admin API key with content:write, for `pnpm components:push`.
# SPINDLE_API_KEY=
